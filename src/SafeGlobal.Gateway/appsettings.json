{
  "ReverseProxy": {
    "Routes": {
      "mortgageRoute": {
        "ClusterId": "mortgageCluster",
        "Match": {
          "Path": "/mortgages/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/mortgages" }
        ]
      },
      "loanRoute": {
        "ClusterId": "loanCluster",
        "Match": {
          "Path": "/loans/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/loans" }
        ]
      }
    },
    "Clusters": {
      "mortgageCluster": {
        "Destinations": {
          "mortgageApi": {
            "Address": "http://127.0.0.1:5262/"
          }
        }
      },
      "loanCluster": {
        "Destinations": {
          "loanApi": {
            "Address": "http://127.0.0.1:5160/"
          }
        }
      }
    }
  }
}
